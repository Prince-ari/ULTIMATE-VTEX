# Copier en `.env.local` puis renseigner les valeurs. Ne JAMAIS committer `.env.local` (il contient des secrets).

DATABASE_URL=mysql://user:password@127.0.0.1:3306/vtex_wallet
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Administrateur créé au premier démarrage
VTEX_INITIAL_ADMIN_EMAIL=admin@example.com
VTEX_INITIAL_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort
VTEX_INITIAL_ADMIN_FIRST_NAME=Admin
VTEX_INITIAL_ADMIN_LAST_NAME=VTEX

# ── Stripe (recharge par carte) ──
# Les clés restent CÔTÉ SERVEUR : jamais dans le code, un zip, un artefact ou un navigateur.
# STRIPE_MODE : auto (défaut) = Stripe réel si les clés sont valides, sinon simulateur local (développement uniquement)
#               real = Stripe réel obligatoire (aucun repli) | sim = simulateur forcé (interdit en production)
STRIPE_MODE=auto
# Verrou des vrais débits : tant que ce flag ne vaut pas "true", aucune clé live n'est acceptée pour débiter.
STRIPE_ALLOW_LIVE_CHARGES=false
# Clé secrète : sk_test_… / sk_live_… ou clé restreinte rk_… (droit PaymentIntents en écriture + Refunds).
# Une clé « mk_… » n'est PAS une clé secrète Stripe : elle est refusée (HTTP 401).
STRIPE_SECRET_KEY=
# Clé publiable : pk_test_… / pk_live_… (même mode que la clé secrète).
STRIPE_PUBLISHABLE_KEY=
# Secret de signature du webhook (whsec_…). Endpoint à déclarer dans Stripe : <API>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
