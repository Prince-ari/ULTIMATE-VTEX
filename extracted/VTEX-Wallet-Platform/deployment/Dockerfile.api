FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @vtex/money build
RUN pnpm --filter @vtex/core build
RUN pnpm --filter @vtex/wallet build
RUN pnpm --filter @vtex/router build
RUN pnpm --filter @vtex/api build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    API_PORT=4000 \
    PORT=4000 \
    HOSTNAME=0.0.0.0
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate
COPY --from=build /app /app
EXPOSE 4000
CMD ["sh", "-c", "pnpm --filter @vtex/core db:migrate && pnpm --filter @vtex/wallet db:migrate && pnpm --filter @vtex/core db:bootstrap-admin && pnpm --filter @vtex/api start"]
